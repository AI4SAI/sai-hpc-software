&GLOBAL
  PROJECT benchmark
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY_FORCE
  PREFERRED_DIAG_LIBRARY CUSOLVER
  DIRECT_GENERALIZED_DIAGONALIZATION T
  ELPA_NEIGVEC_MIN 1
  ELPA_PRINT T
  &TIMINGS
    THRESHOLD 0
    TIMINGS_LEVEL 1
  &END TIMINGS
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 300
      REL_CUTOFF 40
    &END MGRID
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      EPS_SCF 1.0E-9
      MAX_SCF 100
      SCF_GUESS ATOMIC
      CHOLESKY RESTORE
      LEVEL_SHIFT 0
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &OUTER_SCF
        EPS_SCF 1.0E-9
        MAX_SCF 10
      &END OUTER_SCF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
      FILENAME =forces.xyz
      NDIGITS 12
    &END FORCES
  &END PRINT
  &SUBSYS
    &CELL
      ABC 18.6 18.6 18.6
      PERIODIC XYZ
    &END CELL
    &COORD
