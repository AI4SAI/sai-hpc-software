&GLOBAL
  PROJECT benchmark
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY_FORCE
  PREFERRED_DIAG_LIBRARY SL
  &TIMINGS
    THRESHOLD 0
    TIMINGS_LEVEL 1
  &END TIMINGS
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 300
      REL_CUTOFF 40
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MT
    &END POISSON
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS
    &SCF
      EPS_SCF 1.0E-9
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &OUTER_SCF
        EPS_SCF 1.0E-9
        MAX_SCF 10
      &END OUTER_SCF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
      FILENAME =forces.xyz
      NDIGITS 12
    &END FORCES
  &END PRINT
  &SUBSYS
    &CELL
      ABC 12.0 12.0 12.0
      PERIODIC NONE
    &END CELL
    &COORD
      UNIT BOHR
      O -3.04199500181513 -0.24214003254736 0.00000554304386
      O 2.42678178394041 0.25434643589818 0.00000193078253
      H -1.24278357467135 0.08031063038246 -0.00000630765923
      H -3.83888180438040 1.38422361491940 -0.00000174113844
      H 2.84843789645690 -0.73836886176897 -1.45538523208327
      H 2.84844070046958 -0.73837178688373 1.45538580705456
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
