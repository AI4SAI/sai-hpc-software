#%Module1.0
# Select once at load; retain that generation through unload.
set sai_beta_root "/home/stardust/sai-hpc-software/development/sif-beta-20261024-r1/lmod-check/rotation"
if {[info exists env(SAI_SIF_CP2K_BETA_GENERATION)]} {
    set sai_beta_generation $env(SAI_SIF_CP2K_BETA_GENERATION)
} elseif {[module-info mode remove]} {
    error "missing saved beta generation; refusing to unload a different snapshot"
} else {
    set sai_beta_file [open [file join $sai_beta_root channels cp2k] r]
    set sai_beta_generation [string trim [read $sai_beta_file]]
    close $sai_beta_file
}
if {![regexp {^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$} $sai_beta_generation]} {error "invalid beta generation"}
source [file join $sai_beta_root generations $sai_beta_generation modules cp2k]
setenv SAI_SIF_CP2K_BETA_GENERATION $sai_beta_generation
