        "1070:                 # zero_stage=0 or 1: standard DDP (ZeRO-1 will wrap the optimizer)",
        "1071:                 #",
        "1072:                 # ``find_unused_parameters`` makes the reducer traverse the",
        "1073:                 # autograd graph on every iteration to find parameters that",
        "1074:                 # produced no gradient bucket, which it would otherwise wait",
        "1075:                 # for forever. Multi-task needs it, because a step uses one",
        "1076:                 # fitting net and leaves the others out of the graph. A",
        "1077:                 # single-task step reaches every parameter (an all-zero",
        "1078:                 # gradient still produces a bucket), so the traversal is pure",
        "1079:                 # overhead there. A configuration that did leave a parameter",
        "1080:                 # out of the graph would hang the reducer rather than fail, so",
        "1084:                     self.wrapper,",
        "1085:                     device_ids=[LOCAL_RANK],",
        "1086:                     find_unused_parameters=self.multi_task,",
        "1087:                     output_device=LOCAL_RANK,",
