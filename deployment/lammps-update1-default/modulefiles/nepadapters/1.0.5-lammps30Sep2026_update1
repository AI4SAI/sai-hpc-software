#%Module1.0
module-whatis "NEPAdapters 1.0.5; addon for LAMMPS 30Sep2026 update1; Features: nep/cpu; nep/gpu/kk (Kokkos CUDA); ordinary NEP4/NEP5"
proc ModulesHelp {} {
    puts stderr "NEPAdapters 1.0.5; addon for LAMMPS 30Sep2026 update1\nFeatures: nep/cpu; nep/gpu/kk (Kokkos CUDA); ordinary NEP4/NEP5\nBuild information and compatibility checks (readable on login nodes): cat /home/stardust/sai-hpc-software/deployment/lammps-update1-default/build-info/index.txt\nUses the shared plugin files in /opt/apps/nepadapters/1.0.5-lammps30Sep2026/lib.\nRequires lammps/30Sep2026_update1-deepmd320-auto.\nGPU: -k on g N -sf kk -pk kokkos neigh full comm device gpu/aware on.\nNEP3 and CUDA LAMMPS qNEP are unsupported; daily beta builds are not qualified."
}
if {[module-info mode help] || [module-info mode whatis]} {return}
conflict nepadapters
if {[llength [info commands depends-on]]} {
    depends-on lammps/30Sep2026_update1-deepmd320-auto
} else {
    prereq lammps/30Sep2026_update1-deepmd320-auto
}
set prefix /opt/apps/nepadapters/1.0.5-lammps30Sep2026
if {[module-info mode load]} {
    foreach name {nepadapterscpuplugin.so nepadaptersgpuplugin.so} {
        if {![file readable $prefix/lib/$name]} {error "Missing NEPAdapters plugin: $prefix/lib/$name"}
    }
    puts stderr "NEPAdapters 1.0.5; LAMMPS 30Sep2026 update1; styles=nep/cpu,nep/gpu/kk"
}
prepend-path LAMMPS_PLUGIN_PATH $prefix/lib
setenv SAI_NEPADAPTERS_PREFIX $prefix
