#%Module1.0
# SAI module documentation. Static build records are readable without loading this module.
module-whatis "Quantum ESPRESSO 7.6; native CPU/V100 partition selection; Features: MPI/OpenMP; PW/PH/NEB/PP; HDF5; ScaLAPACK; FFTW3; OSCDFT; CUDA/OpenACC on GPU partitions"
proc ModulesHelp {} {
    puts stderr "Quantum ESPRESSO 7.6; native CPU/V100 partition selection\nFeatures: MPI/OpenMP; PW/PH/NEB/PP; HDF5; ScaLAPACK; FFTW3; OSCDFT; CUDA/OpenACC on GPU partitions\nBuild information and installation paths (readable on login nodes): cat /home/stardust/sai-hpc-software/module-info/20261111-paths/qe/7.6-auto/index.txt\nRecorded CMake cache and configure command; PWSCF does not provide a standalone -h option.\nSource: 9f93ddec427d; NVHPC 26.3 / OpenMPI 5.0.10.\nRun with host mpirun; system examples: /opt/sbatch_examples."
}
if {[module-info mode help] || [module-info mode whatis]} {return}
conflict qe
if {[module-info mode load]} {
    if {![info exists env(SLURM_JOB_ID)] || ![regexp {^[1-9][0-9]*$} $env(SLURM_JOB_ID)] || ![info exists env(SLURM_JOB_PARTITION)]} {
        ModulesHelp
        error "Load QE inside a Slurm allocation"
    }
    set partition $env(SLURM_JOB_PARTITION)
} elseif {[module-info mode remove]} {
    if {![info exists env(SAI_QE_NATIVE_PARTITION)]} {error "Missing loaded QE partition"}
    set partition $env(SAI_QE_NATIVE_PARTITION)
} else {return}
switch -- $partition {
    DSPRHBM {set recipe 18629d40806e}
    16V100 - 4V100 - 8V100V0 {set recipe 02bdbc94280c}
    default {error "Unsupported QE partition: $partition"}
}
set prefix /opt/apps/qe/qe-release-qe-7.6-g9f93ddec427d-r${recipe}/$partition
if {[info exists env(QE_ROOT)] && $env(QE_ROOT) ne $prefix} {error "Another QE installation is loaded"}
if {![file executable $prefix/bin/pw.x]} {error "Missing QE installation: $prefix"}
for {set path $prefix} {$path ne "/"} {set path [file dirname $path]} {
    if {[file type $path] eq "link"} {error "Native installation path must not contain symlinks"}
}
prepend-path MODULEPATH /opt/modules/modulefiles/devtools
foreach dependency {openmpi/5.0.10-nvhpc26.3-pgi-cuda12-auto fftw/3.3.10} {
    if {[llength [info commands depends-on]]} {depends-on $dependency} else {module load $dependency}
}
prepend-path PATH $prefix/bin
setenv QE_ROOT $prefix
setenv SAI_QE_NATIVE_PARTITION $partition
if {[module-info mode load]} {puts stderr "QE 7.6 (9f93ddec427d), $partition; native $prefix"}
