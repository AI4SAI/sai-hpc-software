#%Module1.0
module-whatis "ABACUS LTS v3.10.1; snapshot 2026-11-20; native CPU/V100 partition selection"
module-whatis "Source: deepmodeling/abacus-develop; branch LTS; commit 0d967f1f1bc39c16e3bf435e5f02281c72daaf05 (2026-11-16)"
module-whatis "Features: MPI/OpenMP; PW/LCAO; HSE (LibRI); DeePKS (LibTorch 2.1.2); LibXC; ELPA; CUDA sm70 and CAL/cuSOLVERMp on GPU partitions"
module-whatis "Toolchain: OpenMPI 5.0.10 / NVHPC 26.3 GNU; CPU GCC 13.3.0; CUDA 12.9.1; ELPA 2026.02.001; GPU CAL/cuSOLVERMp from NVHPC 25.7"
proc ModulesHelp {} {
    puts stderr "ABACUS LTS v3.10.1; snapshot 2026-11-20\nSource: deepmodeling/abacus-develop, branch LTS\nCommit: 0d967f1f1bc39c16e3bf435e5f02281c72daaf05 (2026-11-16)\nFeatures: MPI/OpenMP; PW/LCAO; HSE (LibRI); DeePKS (LibTorch 2.1.2); LibXC; ELPA; CUDA sm70 and CAL/cuSOLVERMp on GPU partitions\nToolchain: OpenMPI 5.0.10 / NVHPC 26.3 GNU; CPU GCC 13.3.0; CUDA 12.9.1; ELPA 2026.02.001; GPU CAL/cuSOLVERMp from NVHPC 25.7\nPartitions: DSPRHBM, 4V100, 16V100, 8V100V0\nNative installation: /opt/apps/abacus/abacus-development-LTS-2026-11-16-g0d967f1f1bc3-r<recipe>/<PARTITION>\nLoad inside a Slurm allocation, then run with host mpirun. System examples: /opt/sbatch_examples."
}
if {[module-info mode help] || [module-info mode whatis]} {return}
conflict abacus
if {[module-info mode load]} {
    if {![info exists env(SLURM_JOB_ID)] || ![regexp {^[1-9][0-9]*$} $env(SLURM_JOB_ID)] || ![info exists env(SLURM_JOB_PARTITION)]} {
        ModulesHelp
        error "Load this module inside a Slurm allocation"
    }
    set partition $env(SLURM_JOB_PARTITION)
} elseif {[module-info mode remove]} {
    if {![info exists env(SAI_ABACUS_NATIVE_PARTITION)]} {error "Missing loaded ABACUS partition"}
    set partition $env(SAI_ABACUS_NATIVE_PARTITION)
} else {return}
if {$partition ni {DSPRHBM 4V100 16V100 8V100V0}} {error "Unsupported ABACUS partition: $partition"}
set recipe f650f4584906
if {$partition eq "DSPRHBM"} {set recipe 95113744402d}
set prefix [format "/opt/apps/abacus/abacus-development-LTS-2026-11-16-g0d967f1f1bc3-r%s/%s" $recipe $partition]
if {[info exists env(SAI_ABACUS_NATIVE_PARTITION)] && $env(SAI_ABACUS_NATIVE_PARTITION) ne $partition} {error "Another native partition is loaded"}
if {[info exists env(SAI_ABACUS_PREFIX)] && $env(SAI_ABACUS_PREFIX) ne $prefix} {error "Another native build is loaded"}
if {[module-info mode remove] && ![info exists env(SAI_ABACUS_PREFIX)]} {error "Missing loaded ABACUS prefix"}
if {![file executable $prefix/bin/abacus]} {error "Missing ABACUS installation: $prefix"}
for {set path $prefix} {$path ne "/"} {set path [file dirname $path]} {
    if {[file type $path] eq "link"} {error "Native installation path must not contain symlinks"}
}
prepend-path MODULEPATH /opt/modules/modulefiles/devtools
set dependencies {openmpi/5.0.10-nvhpc26.3-gnu-cuda12-auto fftw/3.3.10 libxc/7.0.0-auto saiblas/2603-gnu-auto elpa/2026.02.001-2603-gnu-auto cuda/12.9.1}
if {$partition eq "DSPRHBM"} {
    lappend dependencies gcc/13.3.0
} else {
    lappend dependencies nvmplibs/26.7-tmp
}
foreach dependency $dependencies {
    if {[llength [info commands depends-on]]} {depends-on $dependency} else {module load $dependency}
}
if {$partition ne "DSPRHBM"} {
    set hpcx /opt/devtools/nvidia/hpc_sdk/Linux_x86_64/26.3/comm_libs/12.9/hpcx/hpcx-2.25.1
    foreach component {ucx ucc hcoll} {
        prepend-path LD_LIBRARY_PATH $hpcx/$component/lib
    }
    set math /opt/devtools/nvidia/hpc_sdk/Linux_x86_64/25.7/math_libs/12.9/targets/x86_64-linux/lib
    foreach library {libcal.so.0 libcusolverMp.so.0} {
        if {![file exists $math/$library]} {error "Missing LTS dependency: $math/$library"}
    }
    prepend-path LD_LIBRARY_PATH $math
}
prepend-path LD_LIBRARY_PATH $prefix/dependencies/libtorch/lib
prepend-path PATH $prefix/bin
setenv ABACUS_ROOT $prefix
setenv ABACUS_HOME $prefix
setenv SAI_ABACUS_PREFIX $prefix
setenv SAI_ABACUS_NATIVE_PARTITION $partition
if {[module-info mode load]} {puts stderr "ABACUS LTS v3.10.1 (2026-11-20, 0d967f1f1bc3), $partition; native $prefix"}
