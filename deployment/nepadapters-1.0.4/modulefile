#%Module1.0
module-whatis "NEPAdapters 1.0.4; CPU/CUDA Kokkos addon for LAMMPS 30Sep2026"
proc ModulesHelp {} {
    puts stderr "NEPAdapters 1.0.4 (c934e714); LAMMPS 30Sep2026 addon.
Shared plugins: /opt/apps/nepadapters/1.0.4-lammps30Sep2026/lib
Requires lammps/30Sep2026-deepmd320-auto; load inside a Slurm GPU allocation.
Supports nep/cpu and nep/gpu/kk.
GPU execution requires -k on g N -sf kk -pk kokkos neigh full comm device gpu/aware on.
Ordinary NEP4/NEP5; NEP3 and CUDA LAMMPS qNEP are unsupported.
This module is not a plugin for daily LAMMPS beta builds."
}
conflict nepadapters
if {[llength [info commands depends-on]]} {
    depends-on lammps/30Sep2026-deepmd320-auto
} else {
    prereq lammps/30Sep2026-deepmd320-auto
}
set prefix {/opt/apps/nepadapters/1.0.4-lammps30Sep2026}
if {[module-info mode load]} {
    foreach name {nepadapterscpuplugin.so nepadaptersgpuplugin.so} {
        if {![file readable $prefix/lib/$name]} {error "Missing NEPAdapters plugin: $prefix/lib/$name"}
    }
    puts stderr "NEPAdapters 1.0.4; LAMMPS 30Sep2026; styles=nep/cpu,nep/gpu/kk"
}
prepend-path LAMMPS_PLUGIN_PATH $prefix/lib
setenv SAI_NEPADAPTERS_PREFIX $prefix
