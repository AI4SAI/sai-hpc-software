#%Module1.0
# SAI module documentation. Static build records are readable without loading this module.
module-whatis "BerkeleyGW 4.0; GW and Bethe-Salpeter calculations; Features: MPI/OpenMP; OpenACC/CUDA SM70; real/complex executables; HDF5; FFTW; ScaLAPACK; ELPA"
proc ModulesHelp {} {
    puts stderr "BerkeleyGW 4.0; GW and Bethe-Salpeter calculations\nFeatures: MPI/OpenMP; OpenACC/CUDA SM70; real/complex executables; HDF5; FFTW; ScaLAPACK; ELPA\nFull recorded build information (readable on login nodes): cat /home/stardust/sai-hpc-software/module-info/20261111/berkeleygw/4.0-pgi-auto/index.txt\nLocal build flags: cat /opt/apps/BerkeleyGW/4.0/arch.mk\nInstalled programs: ls /opt/apps/BerkeleyGW/4.0/bin\nLocal documentation: /opt/apps/BerkeleyGW/4.0/documentation/users/"
}
if {[module-info mode help] || [module-info mode whatis]} {return}
module load openmpi/5.0.8-nvhpc25.7-pgi-auto elpa/2025.06.001-2509-pgi-sm70-auto hdf5/1.14.6-pgi-ompi508 fftw/3.3.10
prepend-path PATH /opt/apps/BerkeleyGW/4.0/bin
