#%Module1.0
# SAI module documentation. Inspection commands below are documentation only.
module-whatis "BerkeleyGW 4.0; GW and Bethe-Salpeter calculations"
module-whatis "Features: MPI/OpenMP; OpenACC/CUDA SM70; real/complex executables; HDF5; FFTW; ScaLAPACK; ELPA"
proc ModulesHelp {} {
    puts stderr "BerkeleyGW 4.0; GW and Bethe-Salpeter calculations\nFeatures: MPI/OpenMP; OpenACC/CUDA SM70; real/complex executables; HDF5; FFTW; ScaLAPACK; ELPA\nLocal build flags: cat /opt/apps/BerkeleyGW/4.0/arch.mk\nInstalled programs: ls /opt/apps/BerkeleyGW/4.0/bin\nLocal documentation: /opt/apps/BerkeleyGW/4.0/documentation/users/\nRun print_version_info.x after loading in a compatible allocation."
}
if {[module-info mode help] || [module-info mode whatis]} {return}
module load openmpi/5.0.8-nvhpc25.7-pgi-auto elpa/2025.06.001-2509-pgi-sm70-auto hdf5/1.14.6-pgi-ompi508 fftw/3.3.10
prepend-path PATH /opt/apps/BerkeleyGW/4.0/bin
