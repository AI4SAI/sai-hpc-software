#%Module1.0
# SAI module documentation. Inspection commands below are documentation only.
module-whatis "Multiwfn 2026.3.18; wavefunction analysis"
module-whatis "Features: CPU/OpenMP; command-line noGUI build; density/orbital/topology analysis"
proc ModulesHelp {} {
    puts stderr "Multiwfn 2026.3.18; wavefunction analysis\nFeatures: CPU/OpenMP; command-line noGUI build; density/orbital/topology analysis\nRun Multiwfn interactively; its startup banner and menu describe this build.\nQuick start: /opt/apps/Multiwfn/2026.3.18_bin_Linux_noGUI/Multiwfn quick start.pdf\nExamples: /opt/apps/Multiwfn/2026.3.18_bin_Linux_noGUI/examples\nOpenMP stack setting: OMP_STACKSIZE=4000M."
}
if {[module-info mode help] || [module-info mode whatis]} {return}
#####################################################################
## Multiwfn Environment Module
#####################################################################

set topdir "/opt/apps/Multiwfn/2026.3.18_bin_Linux_noGUI"
set-alias ulimit "ulimit -s unlimited"
setenv OMP_STACKSIZE "4000M"
#setenv Multiwfnpath $topdir
prepend-path PATH $topdir
