#%Module1.0
# SAI module documentation. Static build records are readable without loading this module.
module-whatis "Multiwfn 2026.3.11 (released 2026-03-18); wavefunction analysis; Features: CPU/OpenMP; command-line noGUI build; density/orbital/topology analysis"
proc ModulesHelp {} {
    puts stderr "Multiwfn 2026.3.11 (released 2026-03-18); wavefunction analysis\nFeatures: CPU/OpenMP; command-line noGUI build; density/orbital/topology analysis\nFull recorded build information (readable on login nodes): cat /home/stardust/sai-hpc-software/module-info/20261111/multiwfn/2026.3.18/index.txt\nQuick start: /opt/apps/Multiwfn/2026.3.18_bin_Linux_noGUI/Multiwfn quick start.pdf\nExamples: /opt/apps/Multiwfn/2026.3.18_bin_Linux_noGUI/examples\nOpenMP stack setting: OMP_STACKSIZE=4000M."
}
if {[module-info mode help] || [module-info mode whatis]} {return}
#####################################################################
## Multiwfn Environment Module
#####################################################################

set topdir "/opt/apps/Multiwfn/2026.3.18_bin_Linux_noGUI"
set-alias ulimit "ulimit -s unlimited"
setenv OMP_STACKSIZE "4000M"
#setenv Multiwfnpath $topdir
prepend-path PATH $topdir
