prepend-path PATH /opt/devtools/openmpi/openmpi4.1.6_ucx1.15.0_gdrcopy2.4.1_cuda12.4/bin
prepend-path LD_LIBRARY_PATH /opt/devtools/openmpi/openmpi4.1.6_ucx1.15.0_gdrcopy2.4.1_cuda12.4/lib
setenv NO_STOP_MESSAGE 1
