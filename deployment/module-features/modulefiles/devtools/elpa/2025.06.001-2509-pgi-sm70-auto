#####################################################################
## ELPA (Eigenvalue Solvers for Petaflop-Applications) Modulefile
#####################################################################


# 定义基础路径
set topdir "/opt/devtools/elpa/elpa-2025.06.001-2509-pgi-avx512"

# 设置环境变量 ELPA_ROOT
setenv ELPA_ROOT $topdir

module load openmpi/5.0.8-nvhpc25.7-pgi-auto
# 对应 export PATH=$ELPA_ROOT/bin:$PATH
prepend-path    PATH                $topdir/bin

# 对应 export LD_LIBRARY_PATH=$ELPA_ROOT/lib:$LD_LIBRARY_PATH
prepend-path    LD_LIBRARY_PATH     $topdir/lib

# 对应 export LIBRARY_PATH=$ELPA_ROOT/lib:$LIBRARY_PATH
prepend-path    LIBRARY_PATH        $topdir/lib

# 对应 export LD_RUN_PATH=$ELPA_ROOT/lib:$LD_RUN_PATH
prepend-path    LD_RUN_PATH         $topdir/lib

# 对应 export CPATH=$ELPA_ROOT/include:$CPATH
# 注意：有些系统也习惯用 INCLUDE 变量
prepend-path    CPATH               $topdir/include

# 对应 export PKG_CONFIG_PATH=$ELPA_ROOT/lib/pkgconfig:$PKG_CONFIG_PATH
prepend-path    PKG_CONFIG_PATH     $topdir/lib/pkgconfig

# 对应 export CMAKE_PREFIX_PATH=$ELPA_ROOT:$CMAKE_PREFIX_PATH
prepend-path    CMAKE_PREFIX_PATH   $topdir
