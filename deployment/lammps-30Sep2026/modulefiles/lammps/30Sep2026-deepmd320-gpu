#%Module1.0
module-whatis "LAMMPS 30 Sep 2026 / DeePMD 3.2.0; V100 partition selection"
conflict lammps
if {[module-info mode load]} {
    if {![info exists env(SLURM_JOB_PARTITION)]} {error "Load this module inside a Slurm allocation"}
    set partition $env(SLURM_JOB_PARTITION)
} elseif {[module-info mode remove]} {
    if {![info exists env(SAI_LAMMPS_RELEASE_PARTITION)]} {error "Missing loaded LAMMPS partition"}
    set partition $env(SAI_LAMMPS_RELEASE_PARTITION)
} else {return}
set fragments [dict create 4V100 {/home/stardust/sai-hpc-software/experimental/deepmd-lammps/containers/software/lammps/release/stable_30Sep2026-g8de817dd79bf-r296ed3baa11b-s4abbad547102/4V100/md-39403117741-1-2026-10-20-9bf6ae82814537d7-export.module} 16V100 {/home/stardust/sai-hpc-software/experimental/deepmd-lammps/containers/software/lammps/release/stable_30Sep2026-g8de817dd79bf-r296ed3baa11b-s4abbad547102/16V100/md-39403084059-1-2026-10-20-5fef92e054bacdaf-export.module} 8V100V0 {/home/stardust/sai-hpc-software/experimental/deepmd-lammps/containers/software/lammps/release/stable_30Sep2026-g8de817dd79bf-r795dbd80e2a4-s4abbad547102/8V100V0/md-39427644750-1-2026-10-20-1dfd6f53c113abda.module}]
if {![dict exists $fragments $partition]} {error "Unsupported LAMMPS GPU partition: $partition"}
set fragment [dict get $fragments $partition]
if {![file isfile $fragment] || [file type $fragment] eq "link"} {error "Missing accepted LAMMPS installation"}
source $fragment
setenv SAI_LAMMPS_RELEASE_PARTITION $partition
